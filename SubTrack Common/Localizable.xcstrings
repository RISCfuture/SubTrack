    },
    "SubTrack bundles FFmpeg built with libx264 and libx265, licensed under the GNU General Public License, version 2 or later (GPL v2+). This software uses code of the FFmpeg project licensed under the GPLv2+." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack enthält FFmpeg mit libx264 und libx265, lizenziert unter der GNU General Public License, Version 2 oder höher (GPL v2+). Diese Software verwendet Code des FFmpeg-Projekts, der unter der GPLv2+ lizenziert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack incluye FFmpeg, compilado con libx264 y libx265 y con licencia GNU General Public License, versión 2 o posterior (GPL v2+). Este software utiliza código del proyecto FFmpeg con licencia GPLv2+."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack inclut FFmpeg, compilé avec libx264 et libx265 et placé sous la licence publique générale GNU, version 2 ou ultérieure (GPL v2+). Ce logiciel utilise du code du projet FFmpeg sous licence GPLv2+."
          }
        }
      }
    },
    "SubTrack bundles FFmpeg, built under the GNU Lesser General Public License, version 2.1 or later (LGPL v2.1+), with no GPL-licensed components. Video encoding uses Apple VideoToolbox. This software uses libraries from the FFmpeg project under the LGPLv2.1." : {
      "comment" : "A paragraph summarizing the FFmpeg license.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack enthält FFmpeg, erstellt unter der GNU Lesser General Public License, Version 2.1 oder höher (LGPL v2.1+), ohne GPL-lizenzierte Komponenten. Das Codieren von Video verwendet Apple VideoToolbox. Diese Software verwendet Bibliotheken des FFmpeg-Projekts unter der LGPLv2.1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack incluye FFmpeg, compilado bajo la GNU Lesser General Public License, versión 2.1 o posterior (LGPL v2.1+), sin componentes con licencia GPL. La codificación de vídeo utiliza Apple VideoToolbox. Este software utiliza bibliotecas del proyecto FFmpeg bajo la licencia LGPLv2.1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SubTrack inclut FFmpeg, compilé sous la licence publique générale limitée GNU, version 2.1 ou ultérieure (LGPL v2.1+), sans aucun composant sous licence GPL. L’encodage vidéo utilise Apple VideoToolbox. Ce logiciel utilise des bibliothèques du projet FFmpeg sous licence LGPLv2.1."
          }
        }
      }
    },
