    "Kept in priority order; others are removed. The first language’s audio becomes the default track." : {
      "comment" : "A description of the audio track selection process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Spuren werden in der Reihenfolge ihrer Priorität behalten, alle anderen entfernt. Das Audio der ersten Sprache wird zur Standardspur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se conservan por orden de prioridad; el resto se quita. El audio del primer idioma pasa a ser la pista predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les pistes sont conservées par ordre de priorité ; les autres sont retirées. L’audio de la première langue devient la piste par défaut."
