    "SubTrack bundles FFmpeg built with libx264 and libx265, licensed under the GNU General Public License, version 2 or later (GPL v2+). This software uses code of the FFmpeg project licensed under the GPLv2+." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
