    "%@ (%@)" : {
      "comment" : "An audio channel count and the layout it makes, e.g. “6 (5.1)”. The first argument is the count, the second its name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
