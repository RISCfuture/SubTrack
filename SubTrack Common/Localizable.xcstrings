    "FFmpeg couldn’t be run: %@" : {
      "comment" : "A description of an error that might occur when using the bundled or system `ffmpeg`/`ffprobe` tools. The argument is text describing the underlying error.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
